# Copy to .env.local for local development. Placeholder values only: never commit real secrets.
# Every variable is read and validated in src/server/config.ts.

# Plain config. One of: debug, info, warn, error.
LOG_LEVEL=info

# SECRET. Optional. The shared AI for breakdowns. Without it, only the samples and players' own
# keys (added in Settings) work.
GROQ_API_KEY=

# Plain config. Optional. The Groq model used for breakdowns.
GROQ_MODEL=openai/gpt-oss-120b

# Plain config. Optional. Free breakdowns (shared key) per visitor per hour. Cached public links
# and failed runs do not count.
BREAKDOWNS_PER_HOUR=2

# SECRET. Hosted Postgres connection string (Neon). Required in production.
# Leave empty locally to use the embedded PGlite database stored in PGLITE_DIR.
DATABASE_URL=

# Plain config. Where the embedded database lives when DATABASE_URL is empty.
PGLITE_DIR=.data/pglite
