# Copy to .env.local for local development. Placeholder values only: never commit real secrets.
# Every variable is read and validated in src/server/config.ts. The server refuses to start if one is invalid.

# Plain config. Public base URL of the deployment, used for share links.
APP_BASE_URL=http://localhost:3000

# Plain config. One of: debug, info, warn, error.
LOG_LEVEL=info

# SECRET. At least 32 random characters. Signs the anonymous owner cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# SECRET. Hosted Postgres connection string. Required in production.
# Leave empty locally to use the embedded PGlite database stored in PGLITE_DIR.
DATABASE_URL=

# Plain config. Where the embedded database lives when DATABASE_URL is empty.
PGLITE_DIR=.data/pglite

# SECRET. Optional. Enables AI structuring with Claude. Without it, the built-in rules engine is used.
ANTHROPIC_API_KEY=

# Plain config. Optional. The Claude model used for structuring.
ANTHROPIC_MODEL=claude-opus-5-5
